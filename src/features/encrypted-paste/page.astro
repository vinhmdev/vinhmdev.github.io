---
/**
 * Encrypted Paste — end-to-end encrypted pastebin.
 * VSA slice: self-contained tool with its own styles, scripts, and i18n.
 *
 * Title + note are encrypted in the browser (AES-256-GCM) before storage;
 * the key lives only in the share link's `#fragment`, so the server only
 * ever holds ciphertext. Inspired by paste.sh, rebuilt on Web Crypto +
 * Firestore.
 *
 * The share model (dialog to pick editable / read-only, in-place save,
 * fork, bottom status bar, and the "My pastes" drawer with local version
 * history) is the shared layer used by clipboard2markdown — same logic in
 * both tools.
 *
 * Layout is full-bleed (like clipboard2markdown): no max-width, no card
 * chrome — the editor spans the viewport and the PAGE scrolls as it grows.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Encrypted Paste | VinhMDev"
  description="Share notes with end-to-end encryption. Text is encrypted in your browser; the key never leaves the link."
  lang="en"
  bodyClass="bg-neutral-100 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 min-h-[100dvh] flex flex-col transition-colors duration-300"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@0.372.0/dist/umd/lucide.min.js"
    ></script>
  </Fragment>

  <!-- ===== Header (full-bleed) ===== -->
  <header
    class="sticky top-0 z-20 flex items-center justify-between gap-3 px-4 sm:px-6 py-2.5 backdrop-blur bg-neutral-100/85 dark:bg-neutral-950/85 border-b border-neutral-200 dark:border-neutral-800"
  >
    <a
      href="/"
      class="flex items-center gap-2 no-underline text-inherit hover:opacity-80 transition-opacity"
    >
      <i data-lucide="lock" class="w-5 h-5 text-primary"></i>
      <h1
        class="text-lg font-bold tracking-tight bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent"
        data-i18n="heading"
      >
        Encrypted Paste
      </h1>
    </a>

    <div class="flex items-center gap-2">
      <!-- Share + My pastes (share layer wires these by id) -->
      <button
        id="share-btn"
        class="flex items-center gap-1.5 h-8 px-3 rounded-lg bg-gradient-to-r from-orange-500 to-amber-500 text-white text-xs font-semibold hover:opacity-90 transition-all"
        title="Share"
      >
        <i data-lucide="share-2" class="w-4 h-4"></i>
        <span data-i18n="share_btn">Share</span>
      </button>
      <button
        id="mydocs-btn"
        class="flex items-center justify-center w-8 h-8 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all text-neutral-600 dark:text-neutral-300"
        data-i18n="mydocs_btn_title"
        data-i18n-attr="title"
        title="My pastes"
      >
        <i data-lucide="folder" class="w-4 h-4"></i>
      </button>

      <button
        id="theme-toggle-btn"
        class="flex items-center justify-center w-8 h-8 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all text-neutral-600 dark:text-neutral-300"
        title="Toggle dark/light mode"
      >
        <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
        <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
      </button>
      <button
        id="lang-switch-btn"
        class="flex items-center justify-center gap-1.5 h-8 px-3 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all text-neutral-600 dark:text-neutral-300"
        title="Switch language"
      >
        <span class="text-base">🇻🇳</span><span class="text-xs font-semibold">VI</span>
      </button>
    </div>
  </header>

  <!-- ===== Main: single compose editor ===== -->
  <main class="flex-1 w-full flex flex-col">
    <!-- Title bar -->
    <div class="paste-titlebar">
      <input
        id="paste-title"
        class="paste-title-input"
        type="text"
        maxlength="200"
        placeholder="Untitled note"
        data-i18n="placeholder_title"
        data-i18n-attr="placeholder"
      />
    </div>

    <!-- Auto-growing editor (page scrolls, not the box) -->
    <textarea
      id="paste-input"
      class="paste-editor"
      rows="16"
      placeholder="Type or paste your text here…"
      data-i18n="placeholder_input"
      data-i18n-attr="placeholder"
      autofocus></textarea>

    <div class="paste-editor-foot">
      <span class="flex items-center gap-1.5">
        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-primary"></i>
        <span data-i18n="subtitle">Encrypted in your browser — the server only sees ciphertext.</span>
      </span>
      <span><span id="char-count">0</span>&nbsp;<span data-i18n="chars">chars</span></span>
    </div>
  </main>

  <!-- ===== Toast ===== -->
  <div id="toast" role="status" aria-live="polite" class="paste-toast">
    <span id="toast-icon" aria-hidden="true"></span>
    <span id="toast-msg"></span>
  </div>

  <script>
    import './scripts/app';
  </script>

  <!-- Tool styles (scoped to this page) -->
  <style>
    @import './styles/paste.css';
  </style>

  <!-- Share UI styles — global because the modal/drawer/bar are built in JS
       (createElement), so they don't carry Astro's scoping attribute. -->
  <style is:global>
    @import '../../shared/paste-share/share.css';
  </style>
  <!-- Reserve space so the fixed status bar doesn't cover the editor's foot.
       This page scrolls (min-h flex column), so bottom padding on the body
       lets content clear the bar. --md-sharebar-h is the bar's measured
       height (share.ts); the fallback covers the first paint. -->
  <style is:global>
    body.md-has-sharebar { padding-bottom: var(--md-sharebar-h, 3.25rem); }
  </style>
</BaseLayout>
