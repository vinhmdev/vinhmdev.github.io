---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="LLM Hardware Estimator | VinhMDev"
  description="Roofline-based LLM inference capacity planning. Estimate VRAM, speed, and find the optimal GPU & OS configuration for any open-source model."
  lang="en"
  bodyClass="bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 h-[100dvh] overflow-hidden transition-colors duration-300"
  showFooter={false}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@0.372.0/dist/umd/lucide.min.js"
    ></script>
  </Fragment>

  <div class="profiler-layout">
    <!-- ===== Header ===== -->
    <header class="profiler-header">
      <a href="/" class="profiler-header-title no-underline text-inherit">
        <h1 data-i18n="heading">LLM Hardware Estimator</h1>
        <p data-i18n="subtitle">Roofline-based inference capacity planning</p>
      </a>
      <div class="profiler-header-actions">
        <button id="share-link-btn" class="icon-btn" title="Copy shareable configuration link">
          <i data-lucide="share-2" class="w-4 h-4"></i>
        </button>
        <button id="theme-toggle-btn" class="icon-btn" title="Toggle theme">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
          <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
        </button>
        <button id="lang-switch-btn" class="lang-btn">
          <span>🇬🇧</span><span>EN</span>
        </button>
      </div>
    </header>

    <!-- ===== Mode Selector ===== -->
    <nav class="mode-selector" role="tablist">
      <button
        id="mode-btn-forward"
        class="mode-btn"
        data-mode="forward"
        data-active="true"
        role="tab"
        aria-selected="true"
      >
        <i data-lucide="zap" class="w-3.5 h-3.5"></i>
        <span data-i18n="mode_forward">⚡ Forward</span>
      </button>
      <button
        id="mode-btn-matchmaking"
        class="mode-btn"
        data-mode="matchmaking"
        data-active="false"
        role="tab"
        aria-selected="false"
      >
        <i data-lucide="search" class="w-3.5 h-3.5"></i>
        <span data-i18n="mode_matchmaking">🔍 Matchmaking</span>
      </button>
      <button
        id="mode-btn-discovery"
        class="mode-btn"
        data-mode="discovery"
        data-active="false"
        role="tab"
        aria-selected="false"
      >
        <i data-lucide="puzzle" class="w-3.5 h-3.5"></i>
        <span data-i18n="mode_discovery">🧩 Discovery</span>
      </button>
      <span
        id="mode-desc"
        class="ml-auto text-xs text-neutral-500 self-center"
        data-i18n="mode_forward_desc">Model + Hardware + OS → VRAM, Speed &amp; Quant Matrix</span
      >
    </nav>

    <!-- ===== Main Split ===== -->
    <main class="profiler-main">
      <!-- ─── Input Panel ─── -->
      <aside class="input-panel">
        <div class="input-panel-inner">
          <!-- Group 1: Model (shown in Mode 1 & Mode 2) -->
          <section class="form-section" id="section-model" data-visible-modes="forward,matchmaking">
            <div class="form-section-header">
              <i data-lucide="brain" class="section-icon"></i>
              <span data-i18n="section_model">Model Specifications</span>
            </div>
            <div class="form-section-body single-col">
              <div class="form-field">
                <label class="form-label" for="model-preset" data-i18n="label_model_preset"
                  >Model Preset</label
                >
                <select id="model-preset" class="form-select">
                  <option value="" data-i18n="preset_custom">— Custom —</option>
                </select>
              </div>
              <div class="form-section-body p-0 border-0">
                <div class="form-field">
                  <label class="form-label" for="total-params" data-i18n="label_total_params"
                    >Total Params (B)</label
                  >
                  <input
                    id="total-params"
                    type="number"
                    min="0.1"
                    step="0.1"
                    class="form-input"
                    placeholder="e.g. 70"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="active-params" data-i18n="label_active_params"
                    >Active Params (B)</label
                  >
                  <input
                    id="active-params"
                    type="number"
                    min="0.1"
                    step="0.1"
                    class="form-input"
                    placeholder="= total for dense"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="hidden-size" data-i18n="label_hidden_size"
                    >Hidden Size</label
                  >
                  <input
                    id="hidden-size"
                    type="number"
                    min="64"
                    step="64"
                    class="form-input"
                    placeholder="e.g. 4096"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="num-layers" data-i18n="label_num_layers"
                    >Num Layers</label
                  >
                  <input
                    id="num-layers"
                    type="number"
                    min="1"
                    class="form-input"
                    placeholder="e.g. 32"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="num-query-heads" data-i18n="label_num_query_heads"
                    >Query Heads (n_q)</label
                  >
                  <input
                    id="num-query-heads"
                    type="number"
                    min="1"
                    class="form-input"
                    placeholder="e.g. 32"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="num-kv-heads" data-i18n="label_num_kv_heads"
                    >KV Heads (n_kv)</label
                  >
                  <input
                    id="num-kv-heads"
                    type="number"
                    min="1"
                    class="form-input"
                    placeholder="e.g. 8"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="vocab-size" data-i18n="label_vocab_size"
                    >Vocab Size</label
                  >
                  <input
                    id="vocab-size"
                    type="number"
                    min="1000"
                    class="form-input"
                    placeholder="e.g. 128256"
                  />
                </div>
                <div class="form-field">
                  <label
                    class="form-label"
                    for="max-context-window"
                    data-i18n="label_max_context_window">Max Context (tokens)</label
                  >
                  <input
                    id="max-context-window"
                    type="number"
                    min="512"
                    class="form-input"
                    placeholder="e.g. 8192"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- Group 2: Hardware (shown in Mode 1 & Mode 3) -->
          <section
            class="form-section"
            id="section-hardware"
            data-visible-modes="forward,discovery"
          >
            <div class="form-section-header">
              <i data-lucide="cpu" class="section-icon"></i>
              <span data-i18n="section_hardware">Hardware Configuration</span>
            </div>
            <div class="form-section-body single-col">
              <div class="form-field">
                <label class="form-label" for="hardware-preset" data-i18n="label_hardware_preset"
                  >Hardware Preset</label
                >
                <select id="hardware-preset" class="form-select">
                  <option value="" data-i18n="preset_custom">— Custom —</option>
                </select>
              </div>
              <div class="form-section-body p-0 border-0">
                <div class="form-field">
                  <label class="form-label" for="vram-total-gb" data-i18n="label_vram_total_gb"
                    >VRAM Total (GB)</label
                  >
                  <input
                    id="vram-total-gb"
                    type="number"
                    min="1"
                    step="0.5"
                    class="form-input"
                    placeholder="e.g. 24"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="bandwidth-gbps" data-i18n="label_bandwidth_gbps"
                    >Bandwidth (GB/s)</label
                  >
                  <input
                    id="bandwidth-gbps"
                    type="number"
                    min="1"
                    class="form-input"
                    placeholder="e.g. 1008"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="compute-tflops" data-i18n="label_compute_tflops"
                    >Compute (TFLOPS)</label
                  >
                  <input
                    id="compute-tflops"
                    type="number"
                    min="1"
                    class="form-input"
                    placeholder="e.g. 82.6"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="gpu-count" data-i18n="label_gpu_count"
                    >GPU Count</label
                  >
                  <input
                    id="gpu-count"
                    type="number"
                    min="1"
                    max="16"
                    class="form-input"
                    value="1"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- SLA & Hardware Filters (Mode 2 only) -->
          <section class="form-section hidden" id="section-sla" data-visible-modes="matchmaking">
            <div class="form-section-header">
              <i data-lucide="gauge" class="section-icon"></i>
              <span data-i18n="section_sla">SLA &amp; Hardware Filters</span>
            </div>
            <div class="form-section-body">
              <div class="form-field">
                <label class="form-label" for="min-tps" data-i18n="label_min_tps"
                  >Min Tok/s per User</label
                >
                <input id="min-tps" type="number" min="1" class="form-input" value="15" />
              </div>
              <div class="form-field">
                <label class="form-label" for="max-ttft" data-i18n="label_max_ttft"
                  >Max TTFT (ms)</label
                >
                <input id="max-ttft" type="number" min="50" class="form-input" value="3000" />
              </div>
              <div class="form-field">
                <label class="form-label" for="max-buy-price" data-i18n="label_max_buy_price"
                  >Max Buy Budget ($)</label
                >
                <input
                  id="max-buy-price"
                  type="number"
                  min="0"
                  step="100"
                  class="form-input"
                  value="0"
                  placeholder="0 = No limit"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="max-hourly-cost" data-i18n="label_max_hourly_cost"
                  >Max Cloud Cost ($/hr)</label
                >
                <input
                  id="max-hourly-cost"
                  type="number"
                  min="0"
                  step="0.5"
                  class="form-input"
                  value="0"
                  placeholder="0 = No limit"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="vendor-filter" data-i18n="label_vendor_filter"
                  >GPU Vendor</label
                >
                <select id="vendor-filter" class="form-select">
                  <option value="all" data-i18n="filter_all_vendors"
                    >All Vendors (NVIDIA / AMD / Apple / Intel)</option
                  >
                  <option value="Nvidia">NVIDIA</option>
                  <option value="AMD">AMD (Radeon / Instinct / Ryzen AI)</option>
                  <option value="Apple">Apple Silicon</option>
                  <option value="Intel">Intel Arc</option>
                </select>
              </div>
              <div class="form-field">
                <label class="form-label" for="arch-filter" data-i18n="label_arch_filter"
                  >Hardware Tier</label
                >
                <select id="arch-filter" class="form-select">
                  <option value="all" data-i18n="filter_all_tiers">All Tiers</option>
                  <option value="consumer" data-i18n="tier_consumer">Consumer / Prosumer GPU</option
                  >
                  <option value="workstation" data-i18n="tier_workstation"
                    >Workstation / Cloud Inference</option
                  >
                  <option value="apple_silicon" data-i18n="tier_apple_silicon"
                    >Apple Silicon Unified</option
                  >
                  <option value="datacenter" data-i18n="tier_datacenter">Datacenter Server</option>
                </select>
              </div>
              <div class="form-field span-2">
                <label class="form-label" for="sort-by" data-i18n="label_sort_by"
                  >Sort Ranking By</label
                >
                <select id="sort-by" class="form-select">
                  <option value="cost_hr" data-i18n="sort_cost_hr"
                    >Lowest Cloud / Hourly Cost ($/hr)</option
                  >
                  <option value="buy_price" data-i18n="sort_buy_price"
                    >Lowest Hardware Buy Price ($)</option
                  >
                  <option value="roi" data-i18n="sort_roi">Best ROI (Tok/s per $/hr)</option>
                  <option value="tps" data-i18n="sort_tps">Fastest Per-User Decode (Tok/s)</option>
                  <option value="ttft" data-i18n="sort_ttft">Lowest Prefill Latency (TTFT)</option>
                </select>
              </div>
            </div>
          </section>

          <!-- Group 3: Runtime & OS -->
          <section class="form-section" id="section-runtime">
            <div class="form-section-header">
              <i data-lucide="settings-2" class="section-icon"></i>
              <span data-i18n="section_runtime">Runtime &amp; OS Environment</span>
            </div>
            <div class="form-section-body">
              <div class="form-field span-2">
                <label class="form-label" for="os-profile" data-i18n="label_os_profile"
                  >OS / Driver Environment</label
                >
                <select id="os-profile" class="form-select">
                  <option value="auto" data-i18n="os_auto">Auto (Hardware Native Default)</option>
                  <option value="linux_headless" data-i18n="os_linux_headless"
                    >Linux Server / Headless (95% VRAM)</option
                  >
                  <option value="linux_gui" data-i18n="os_linux_gui"
                    >Linux Desktop X11/Wayland (90% VRAM)</option
                  >
                  <option value="windows_wsl2" data-i18n="os_windows_wsl2"
                    >Windows 11 + WSL2 (85% VRAM)</option
                  >
                  <option value="windows_native" data-i18n="os_windows_native"
                    >Windows 11 Native WDDM (82% VRAM)</option
                  >
                  <option value="macos_default" data-i18n="os_macos_default"
                    >macOS Unified Default (75% RAM)</option
                  >
                  <option value="macos_tuned" data-i18n="os_macos_tuned"
                    >macOS sysctl Tuned (88% RAM)</option
                  >
                </select>
              </div>
              <div class="form-field span-2">
                <label class="form-label" for="weight-quant" data-i18n="label_weight_quant"
                  >Weight Quantization</label
                >
                <select id="weight-quant" class="form-select">
                  <option value="FP16">FP16 / BF16 (2.00 B/param)</option>
                  <option value="INT8">INT8 / FP8 (1.05 B/param)</option>
                  <option value="GGUF_Q8_0">GGUF Q8_0 (1.10 B/param)</option>
                  <option value="GGUF_Q6_K">GGUF Q6_K (0.82 B/param)</option>
                  <option value="GGUF_Q5_K_M">GGUF Q5_K_M (0.72 B/param)</option>
                  <option value="GGUF_Q4_K_M" selected>GGUF Q4_K_M (0.62 B/param)</option>
                  <option value="AWQ">AWQ / GPTQ / EXL2 4-bit (0.60 B/param)</option>
                  <option value="GGUF_IQ3_XXS">GGUF IQ3_XXS 3-bit (0.43 B/param)</option>
                </select>
              </div>
              <div class="form-field">
                <label class="form-label" for="kv-quant" data-i18n="label_kv_quant"
                  >KV Cache Quant</label
                >
                <select id="kv-quant" class="form-select">
                  <option value="FP16">FP16 (2.0 B/param)</option>
                  <option value="FP8">FP8 / Q8_0 (1.0 B/param)</option>
                  <option value="INT4">INT4 / Q4_0 (0.55 B/param)</option>
                </select>
              </div>
              <div class="form-field">
                <label class="form-label" for="context-limit" data-i18n="label_context_limit"
                  >Active Context / User</label
                >
                <input
                  id="context-limit"
                  type="number"
                  min="512"
                  step="512"
                  class="form-input"
                  value="4096"
                  placeholder="e.g. 4096"
                />
              </div>
              <div class="form-field span-2">
                <label class="form-label" for="inference-engine" data-i18n="label_engine"
                  >Inference Engine</label
                >
                <select id="inference-engine" class="form-select">
                  <option value="vLLM" data-i18n="engine_vllm"
                    >vLLM / SGLang (PagedAttention, 4% frag)</option
                  >
                  <option value="TensorRT_LLM" data-i18n="engine_trt_llm"
                    >NVIDIA TensorRT-LLM (Paged + Fusion, 3% frag)</option
                  >
                  <option value="llama_cpp" data-i18n="engine_llama_cpp"
                    >llama.cpp / Ollama (GGUF C++, 5% frag)</option
                  >
                  <option value="MLX" data-i18n="engine_mlx"
                    >Apple MLX (Unified Zero-Copy, 4% frag)</option
                  >
                  <option value="Standard_HF" data-i18n="engine_standard_hf"
                    >Standard HuggingFace (Unpaged, 20% frag)</option
                  >
                </select>
              </div>
              <div class="form-field span-2">
                <label class="form-label" for="multi-gpu-mode" data-i18n="label_multi_gpu_mode"
                  >Multi-GPU Strategy</label
                >
                <select id="multi-gpu-mode" class="form-select">
                  <option value="tensor_parallel" data-i18n="mgpu_tensor"
                    >Tensor Parallelism (vLLM / NCCL Sharded)</option
                  >
                  <option value="pipeline_parallel" data-i18n="mgpu_pipeline"
                    >Pipeline / Layer Split (llama.cpp Sequential)</option
                  >
                </select>
              </div>
            </div>
          </section>

          <!-- Group 4: Workload -->
          <section class="form-section" id="section-workload">
            <div class="form-section-header">
              <i data-lucide="users" class="section-icon"></i>
              <span data-i18n="section_workload">Traffic &amp; Workload</span>
            </div>
            <div class="form-section-body">
              <div class="form-field span-2">
                <label
                  class="form-label"
                  for="max-concurrent-reqs"
                  data-i18n="label_concurrent_reqs">Max Concurrent Requests</label
                >
                <input
                  id="max-concurrent-reqs"
                  type="number"
                  min="1"
                  max="1000"
                  class="form-input"
                  value="4"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="avg-input-tokens" data-i18n="label_avg_input_tokens"
                  >Avg Input Tokens</label
                >
                <input id="avg-input-tokens" type="number" min="1" class="form-input" value="512" />
              </div>
              <div class="form-field">
                <label
                  class="form-label"
                  for="avg-output-tokens"
                  data-i18n="label_avg_output_tokens">Avg Output Tokens</label
                >
                <input
                  id="avg-output-tokens"
                  type="number"
                  min="1"
                  class="form-input"
                  value="256"
                />
              </div>
              <div class="form-field span-2">
                <label class="form-label" for="shared-prefix" data-i18n="label_shared_prefix"
                  >Shared Prefix (tokens)</label
                >
                <input id="shared-prefix" type="number" min="0" class="form-input" value="0" />
                <span class="form-hint" data-i18n="hint_shared_prefix"
                  >Tokens shared across all users (e.g. RAG system prompt)</span
                >
              </div>
            </div>
          </section>

          <!-- Advanced Optimisations -->
          <section class="form-section" id="section-advanced">
            <div class="form-section-header">
              <i data-lucide="sliders-horizontal" class="section-icon"></i>
              <span data-i18n="section_advanced">Advanced Optimisations</span>
            </div>
            <div class="form-section-body single-col gap-1">
              <!-- APC -->
              <label class="toggle-item">
                <span class="toggle-switch">
                  <input type="checkbox" id="toggle-apc" />
                  <span class="toggle-slider"></span>
                </span>
                <span class="toggle-label" data-i18n="toggle_apc"
                  >Automatic Prefix Caching (APC)</span
                >
              </label>

              <!-- Speculative Decoding -->
              <label class="toggle-item">
                <span class="toggle-switch">
                  <input type="checkbox" id="toggle-spec-decoding" />
                  <span class="toggle-slider"></span>
                </span>
                <span class="toggle-label" data-i18n="toggle_spec_decoding"
                  >Speculative Decoding</span
                >
              </label>
              <div id="spec-decoding-fields" class="sub-fields hidden">
                <div class="form-field">
                  <label class="form-label" for="draft-params" data-i18n="label_draft_params"
                    >Draft Params (B)</label
                  >
                  <input
                    id="draft-params"
                    type="number"
                    min="0.1"
                    step="0.1"
                    class="form-input"
                    value="1.5"
                  />
                </div>
                <div class="form-field">
                  <label class="form-label" for="acceptance-rate" data-i18n="label_acceptance_rate"
                    >Acceptance Rate</label
                  >
                  <input
                    id="acceptance-rate"
                    type="number"
                    min="1.0"
                    max="3.0"
                    step="0.1"
                    class="form-input"
                    value="1.8"
                  />
                </div>
              </div>

              <!-- Chunked Prefill -->
              <label class="toggle-item">
                <span class="toggle-switch">
                  <input type="checkbox" id="toggle-chunked-prefill" />
                  <span class="toggle-slider"></span>
                </span>
                <span class="toggle-label" data-i18n="toggle_chunked_prefill">Chunked Prefill</span>
              </label>
              <div id="chunked-prefill-fields" class="sub-fields hidden">
                <div class="form-field span-2">
                  <label class="form-label" for="chunk-size" data-i18n="label_chunk_size"
                    >Chunk Size (tokens)</label
                  >
                  <input
                    id="chunk-size"
                    type="number"
                    min="64"
                    step="64"
                    class="form-input"
                    value="512"
                  />
                </div>
              </div>

              <!-- Hybrid System RAM Offloading -->
              <label class="toggle-item">
                <span class="toggle-switch">
                  <input type="checkbox" id="toggle-ram-offload" />
                  <span class="toggle-slider"></span>
                </span>
                <span class="toggle-label" data-i18n="toggle_ram_offload"
                  >Hybrid System RAM Offload (CPU + GPU)</span
                >
              </label>
              <div id="ram-offload-fields" class="sub-fields hidden">
                <div class="form-field span-2">
                  <label class="form-label" for="system-ram-tier" data-i18n="label_ram_tier"
                    >System RAM Type</label
                  >
                  <select id="system-ram-tier" class="form-select">
                    <option value="ddr5_dual" data-i18n="ram_ddr5_dual"
                      >DDR5 Dual-Channel (~67 GB/s eff)</option
                    >
                    <option value="ddr4_dual" data-i18n="ram_ddr4_dual"
                      >DDR4 Dual-Channel (~37 GB/s eff)</option
                    >
                    <option value="ddr5_server" data-i18n="ram_ddr5_server"
                      >DDR5 8-Channel Server (~240 GB/s eff)</option
                    >
                  </select>
                </div>
                <div class="form-field span-2">
                  <label class="form-label" for="system-ram-gb" data-i18n="label_ram_gb"
                    >Available System RAM (GB)</label
                  >
                  <input
                    id="system-ram-gb"
                    type="number"
                    min="4"
                    max="2048"
                    step="4"
                    class="form-input"
                    value="64"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- Legacy synced selector kept for DOM compatibility -->
          <section class="form-section hidden" id="section-hardware-discovery">
            <select id="hardware-preset-discovery" class="form-select">
              <option value="">— Select Hardware —</option>
            </select>
          </section>

          <!-- Calculate Button -->
          <button id="btn-calculate" class="btn-calculate">
            <i data-lucide="calculator" class="w-4 h-4"></i>
            <span id="btn-calculate-label" data-i18n="btn_calculate">Calculate</span>
          </button>
        </div>
      </aside>

      <!-- ─── Results Panel ─── -->
      <section class="results-panel" id="results-panel">
        <div id="results-empty" class="results-empty">
          <i data-lucide="bar-chart-2" class="results-empty-icon"></i>
          <p>
            Fill in the model &amp; hardware details on the left, then click <strong
              >Calculate</strong
            >.
          </p>
        </div>
        <div id="results-content" class="results-panel-inner hidden">
          <!-- VRAM Result (Mode 1) -->
          <div id="result-vram" class="result-card">
            <div class="result-card-header">
              <i
                data-lucide="memory-stick"
                class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_vram_title">VRAM &amp; Capacity Breakdown</span>
              <span id="vram-status-badge" class="status-badge fit ml-auto" data-i18n="badge_fit"
                >✓ Fits</span
              >
            </div>
            <div class="result-card-body">
              <div class="vram-bar-wrapper">
                <div class="vram-bar" id="vram-bar">
                  <div id="vram-seg-weights" class="vram-bar-segment weights w-0"></div>
                  <div id="vram-seg-kv" class="vram-bar-segment kv w-0"></div>
                  <div id="vram-seg-overhead" class="vram-bar-segment overhead w-0"></div>
                </div>
                <div class="vram-legend">
                  <span class="vram-legend-item"
                    ><span class="vram-legend-dot weights"></span><span data-i18n="result_weights"
                      >Weights</span
                    ><strong id="vram-val-weights" class="vram-legend-val">—</strong></span
                  >
                  <span class="vram-legend-item"
                    ><span class="vram-legend-dot kv"></span><span data-i18n="result_kv_cache"
                      >KV Cache</span
                    ><strong id="vram-val-kv" class="vram-legend-val">—</strong></span
                  >
                  <span class="vram-legend-item"
                    ><span class="vram-legend-dot overhead"></span><span data-i18n="result_overhead"
                      >Overhead</span
                    ><strong id="vram-val-overhead" class="vram-legend-val">—</strong></span
                  >
                </div>
              </div>
              <div class="vram-stats vram-stats-5">
                <div class="vram-stat">
                  <div class="vram-stat-value" id="vram-total">—</div>
                  <div class="vram-stat-label" data-i18n="result_total">Total Required</div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="vram-available">—</div>
                  <div class="vram-stat-label" data-i18n="result_available">Available</div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="vram-utilization">—</div>
                  <div class="vram-stat-label" data-i18n="result_utilization">Utilisation</div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="vram-max-users">—</div>
                  <div class="vram-stat-label" data-i18n="result_max_users">
                    Max Concurrent Users
                  </div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="vram-max-context">—</div>
                  <div class="vram-stat-label" data-i18n="result_max_context">
                    Max 1-User Context
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Speed Result (Mode 1) -->
          <div id="result-speed" class="result-card">
            <div class="result-card-header">
              <i data-lucide="gauge" class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_speed_title">Speed &amp; Roofline Estimates</span>
              <span id="speed-regime-badge" class="regime-badge ml-auto"
                >Memory-Bandwidth Bound</span
              >
            </div>
            <div class="result-card-body">
              <div class="speed-grid speed-grid-4">
                <div class="speed-card">
                  <div class="speed-card-value" id="speed-ttft">—</div>
                  <div class="speed-card-unit" data-i18n="unit_ms">ms</div>
                  <div class="speed-card-label" data-i18n="result_prefill_ttft">Prefill TTFT</div>
                </div>
                <div class="speed-card">
                  <div class="speed-card-value" id="speed-system-tps">—</div>
                  <div class="speed-card-unit" data-i18n="unit_tps">tok/s</div>
                  <div class="speed-card-label" data-i18n="result_system_tps">
                    System Throughput
                  </div>
                </div>
                <div class="speed-card">
                  <div class="speed-card-value" id="speed-user-tps">—</div>
                  <div class="speed-card-unit" data-i18n="unit_tps">tok/s</div>
                  <div class="speed-card-label" data-i18n="result_user_tps">Per-User Speed</div>
                </div>
                <div class="speed-card">
                  <div class="speed-card-value" id="speed-e2e">—</div>
                  <div class="speed-card-unit" data-i18n="unit_s">s</div>
                  <div class="speed-card-label" data-i18n="result_e2e_latency">
                    E2E Response Time
                  </div>
                </div>
              </div>
              <div class="effective-hw-bar">
                <span data-i18n="label_effective_hw">Effective Hardware:</span>
                <strong id="effective-hw-summary">—</strong>
              </div>
            </div>
          </div>

          <!-- Quantization Comparison Matrix (Mode 1) -->
          <div id="result-quant-matrix" class="result-card">
            <div class="result-card-header">
              <i data-lucide="layers" class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"
              ></i>
              <span data-i18n="result_quant_matrix_title"
                >Quantization Comparison on This Hardware</span
              >
            </div>
            <div class="result-card-body p-0 overflow-x-auto">
              <table class="match-table" id="quant-matrix-table">
                <thead>
                  <tr>
                    <th data-i18n="col_quant">Quantization</th>
                    <th data-i18n="col_weights_gb">Weights</th>
                    <th data-i18n="col_total_vram">Total VRAM</th>
                    <th data-i18n="col_status">Status</th>
                    <th data-i18n="col_user_tps">Tok/s / User</th>
                    <th data-i18n="col_max_ctx">Max 1-User Ctx</th>
                  </tr>
                </thead>
                <tbody id="quant-matrix-body"></tbody>
              </table>
            </div>
          </div>

          <!-- OS & Driver Environment Comparison Matrix (Mode 1) -->
          <div id="result-os-matrix" class="result-card">
            <div class="result-card-header">
              <i
                data-lucide="monitor-cog"
                class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_os_matrix_title"
                >OS &amp; Driver Environment Comparison on This Hardware</span
              >
            </div>
            <div class="result-card-body p-0 overflow-x-auto">
              <table class="match-table" id="os-matrix-table">
                <thead>
                  <tr>
                    <th data-i18n="col_os_profile">OS / Driver Environment</th>
                    <th data-i18n="col_usable_vram">Usable VRAM</th>
                    <th data-i18n="col_status">Status</th>
                    <th data-i18n="col_user_tps">Tok/s / User</th>
                    <th data-i18n="col_max_users">Max Users</th>
                    <th data-i18n="col_max_ctx">Max 1-User Ctx</th>
                  </tr>
                </thead>
                <tbody id="os-matrix-body"></tbody>
              </table>
            </div>
          </div>

          <!-- Matchmaking Table (Mode 2) -->
          <div id="result-matchmaking" class="result-card hidden">
            <div class="result-card-header">
              <i
                data-lucide="list-ordered"
                class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_match_title">Compatible Hardware Options</span>
              <span id="match-count-badge" class="regime-badge ml-auto">0</span>
            </div>
            <div class="result-card-body p-0 overflow-x-auto">
              <table class="match-table" id="match-table">
                <thead>
                  <tr>
                    <th data-i18n="col_hardware">Hardware</th>
                    <th data-i18n="col_tier">Vendor / Tier</th>
                    <th data-i18n="col_vram_fit">VRAM Fit</th>
                    <th data-i18n="col_user_tps">Tok/s / User</th>
                    <th data-i18n="col_ttft">TTFT</th>
                    <th data-i18n="col_buy_price">Est. Buy $</th>
                    <th data-i18n="col_cost">$/hr</th>
                    <th data-i18n="col_roi">ROI</th>
                  </tr>
                </thead>
                <tbody id="match-table-body"></tbody>
              </table>
              <p
                id="match-no-result"
                class="hidden p-3.5 text-xs text-neutral-500"
                data-i18n="no_match_found"
              >
                No hardware meets your SLA constraints.
              </p>
            </div>
          </div>

          <!-- Discovery Result (Mode 3) -->
          <div id="result-discovery" class="result-card hidden">
            <div class="result-card-header">
              <i
                data-lucide="package-search"
                class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_discovery_title">Maximum Model Size (Synthetic Ceiling)</span>
            </div>
            <div class="result-card-body">
              <div class="vram-stats">
                <div class="vram-stat">
                  <div class="vram-stat-value" id="discovery-max-params">—</div>
                  <div class="vram-stat-label" data-i18n="discovery_max_params">Max Params</div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="discovery-hidden">—</div>
                  <div class="vram-stat-label" data-i18n="discovery_est_hidden">
                    Est. Hidden Size
                  </div>
                </div>
                <div class="vram-stat">
                  <div class="vram-stat-value" id="discovery-layers">—</div>
                  <div class="vram-stat-label" data-i18n="discovery_est_layers">Est. Layers</div>
                </div>
              </div>
              <div class="mt-3 flex gap-2 flex-wrap items-center">
                <span class="text-xs text-neutral-500" data-i18n="discovery_bottleneck"
                  >Bottleneck:</span
                >
                <span
                  id="discovery-bottleneck"
                  class="text-xs font-semibold text-primary-500 dark:text-primary-400">—</span
                >
                <span class="text-xs text-neutral-500 ml-2" data-i18n="discovery_recommended"
                  >Recommended Quant:</span
                >
                <span id="discovery-quant" class="text-xs font-semibold">—</span>
              </div>
            </div>
          </div>

          <!-- Compatible Preset Models Table (Mode 3) -->
          <div id="result-discovery-presets" class="result-card hidden">
            <div class="result-card-header">
              <i
                data-lucide="check-circle-2"
                class="w-3.5 h-3.5 text-primary-500 dark:text-primary-400"></i>
              <span data-i18n="result_discovery_presets_title"
                >Compatible Open-Source Models on This Hardware</span
              >
              <span id="discovery-presets-count" class="regime-badge ml-auto">0</span>
            </div>
            <div class="result-card-body p-0 overflow-x-auto">
              <table class="match-table" id="discovery-presets-table">
                <thead>
                  <tr>
                    <th data-i18n="col_model">Model</th>
                    <th data-i18n="col_params">Params</th>
                    <th data-i18n="col_quant_used">Quantization</th>
                    <th data-i18n="col_vram_fit">VRAM Fit</th>
                    <th data-i18n="col_user_tps">Tok/s / User</th>
                    <th data-i18n="col_ttft">TTFT</th>
                  </tr>
                </thead>
                <tbody id="discovery-presets-body"></tbody>
              </table>
              <p
                id="discovery-no-presets"
                class="hidden p-3.5 text-xs text-neutral-500"
                data-i18n="no_presets_fit"
              >
                No preset models fit with current settings.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Toast -->
  <div id="profiler-toast">
    <span id="profiler-toast-icon"></span>
    <span id="profiler-toast-msg"></span>
  </div>

  <script>
    import './scripts/app';
  </script>

  <style>
    @import './styles/profiler.css';
  </style>
</BaseLayout>
