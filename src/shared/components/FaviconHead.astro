---
/**
 * FaviconHead — Shared favicon <link> tags for light/dark mode.
 * Include in <head> of every page via BaseLayout.
 */
---

<!-- Favicons (light mode) -->
<link
  rel="icon"
  type="image/svg+xml"
  href="/internal/favicon/favicon.svg"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/x-icon"
  href="/internal/favicon/favicon.ico"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/png"
  sizes="96x96"
  href="/internal/favicon/favicon-96x96.png"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/internal/favicon/apple-touch-icon.png"
  media="(prefers-color-scheme: light)"
/>
<!-- Favicons (dark mode) -->
<link
  rel="icon"
  type="image/svg+xml"
  href="/internal/favicon-dark/favicon.svg"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="icon"
  type="image/x-icon"
  href="/internal/favicon-dark/favicon.ico"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="icon"
  type="image/png"
  sizes="96x96"
  href="/internal/favicon-dark/favicon-96x96.png"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/internal/favicon-dark/apple-touch-icon.png"
  media="(prefers-color-scheme: dark)"
/>
<link rel="manifest" href="/internal/favicon/site.webmanifest" />
