---
/**
 * Footer — Shared site footer with copyright text and optional Privacy Policy link.
 * Sticky footer in normal document flow: stays at the bottom of the viewport when
 * content is short, and scrolls naturally below content when content is tall.
 */
interface Props {
  text: string;
  privacyLabel?: string;
  privacyUrl?: string;
  sourceLabel?: string;
  sourceUrl?: string;
}
const { text, privacyLabel, privacyUrl, sourceLabel, sourceUrl } = Astro.props;
---

<footer
  class="w-full max-w-[640px] mx-auto py-6 px-4 sm:px-6 md:px-8 mt-auto flex-shrink-0 relative z-10 text-neutral-500 dark:text-neutral-400 text-xs opacity-75 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center"
>
  <span>{text}</span>
  {
    privacyUrl && privacyLabel && (
      <>
        <span aria-hidden="true">·</span>
        <a
          href={privacyUrl}
          target="_blank"
          class="hover:opacity-100 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors underline-offset-2 hover:underline"
        >
          {privacyLabel}
        </a>
      </>
    )
  }
  {
    sourceUrl && sourceLabel && (
      <>
        <span aria-hidden="true">·</span>
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener"
          class="hover:opacity-100 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors underline-offset-2 hover:underline"
        >
          {sourceLabel}
        </a>
      </>
    )
  }
</footer>
