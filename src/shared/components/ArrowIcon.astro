---
/**
 * ArrowIcon — Reusable right-arrow SVG icon.
 * Used in tool cards on the homepage.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`tool-arrow ${className}`}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
</svg>
