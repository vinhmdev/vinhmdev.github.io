rules_version = '2';

// Security Rules for the paste tools (Encrypted Paste + Paste-to-Markdown share).
//
// Content is encrypted client-side (AES-256-GCM) before it arrives here, so
// these rules do NOT protect confidentiality — the encryption does. Their job
// is to stop abuse (cap size, forbid enumeration) and to enforce the paste's
// share mode:
//   - mode 'readonly' : immutable once created.
//   - mode 'editable' : content can be overwritten in place by anyone with the
//                       link (there is no auth; the link IS the capability).
//
// Deploy: paste into Firebase Console → Firestore → Rules → Publish, or
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    match /pastes/{pasteId} {
      // Read a single paste by its unguessable auto-id (ciphertext only).
      allow get: if true;
      // No listing / enumeration.
      allow list: if false;

      // Create-only, strict shape + size validation.
      // Signed-in creators may attach their `ownerUid` so they can later
      // extend expiration or revoke/delete the shared paste.
      allow create: if
        request.resource.data.keys().hasOnly(['ct', 'iv', 'v', 'mode', 'createdAt', 'updatedAt', 'expireAt', 'ownerUid'])
        && request.resource.data.v == 2
        && request.resource.data.mode in ['editable', 'readonly']
        && request.resource.data.ct is string
        && request.resource.data.ct.size() > 0
        && request.resource.data.ct.size() <= 900000          // ~900 KB ciphertext cap (Firestore doc limit is 1 MiB)
        && request.resource.data.iv is string
        && request.resource.data.iv.size() > 0
        && request.resource.data.iv.size() <= 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.expireAt == null
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt > request.time
                && request.resource.data.expireAt < request.time + duration.value(366, 'd')))
        && (!('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == null
            || (request.auth != null && request.resource.data.ownerUid == request.auth.uid));

      // Updates allowed in two cases:
      // 1. Editable pastes: content-only, in-place updates by anyone with the link.
      // 2. Signed-in owner: extending or updating `expireAt` (and `updatedAt`)
      //    regardless of whether the paste is editable or readonly.
      allow update: if
        (resource.data.mode == 'editable'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ct', 'iv', 'updatedAt'])
          && request.resource.data.ct is string
          && request.resource.data.ct.size() > 0
          && request.resource.data.ct.size() <= 900000
          && request.resource.data.iv is string
          && request.resource.data.iv.size() > 0
          && request.resource.data.iv.size() <= 32
          && request.resource.data.updatedAt == request.time)
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expireAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.expireAt == null
              || (request.resource.data.expireAt is timestamp
                  && request.resource.data.expireAt > request.time
                  && request.resource.data.expireAt < request.time + duration.value(366, 'd'))));

      // Signed-in owners can revoke/delete their own shared pastes at any time.
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Authenticated Google Account Workspace (Dual Independent Storage):
    // Strict owner isolation — only the signed-in owner (`request.auth.uid == uid`)
    // can read, write, or delete their own shared doc history and working drafts.
    match /users/{uid}/md_docs/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id is string
        && request.resource.data.url is string;
    }

    match /users/{uid}/paste_docs/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id is string
        && request.resource.data.url is string;
    }

    match /users/{uid}/drafts/{toolId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && toolId in ['c2md', 'paste']
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 900000;
    }

    // Everything else is denied by default.
  }
}
