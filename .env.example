# Firebase Analytics environment variables
# Copy this file to .env and fill in the values from your Firebase project settings.
# Then inject these into your CI/CD build environment (Cloudflare Pages, Netlify, GitHub Actions).
#
# IMPORTANT: Never commit the .env file or the actual values to Git.
#
# Astro reads these via: import.meta.env.PUBLIC_* in components/scripts.
# The PUBLIC_ prefix is required for client-side access.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
